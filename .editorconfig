root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{csproj,props,targets,json,slnx}]
indent_size = 2

[*.cs]
# Style the code already follows, raised to warnings so EnforceCodeStyleInBuild enforces it.
csharp_style_namespace_declarations = file_scoped:warning
dotnet_diagnostic.IDE0161.severity = warning
dotnet_diagnostic.IDE0005.severity = warning

csharp_style_var_for_built_in_types = true:warning
csharp_style_var_when_type_is_apparent = true:warning
csharp_style_var_elsewhere = true:warning
dotnet_diagnostic.IDE0007.severity = warning

# Single-statement bodies go without braces, consistently.
csharp_prefer_braces = false:silent

dotnet_style_readonly_field = true:warning
dotnet_diagnostic.IDE0044.severity = warning

csharp_style_prefer_primary_constructors = false:silent

# Static readonly and const fields are PascalCase (more specific than the rule below, so they win).
dotnet_naming_rule.constants.symbols = constants
dotnet_naming_rule.constants.style = pascal
dotnet_naming_rule.constants.severity = warning
dotnet_naming_symbols.constants.applicable_kinds = field
dotnet_naming_symbols.constants.required_modifiers = static, readonly
dotnet_naming_rule.consts.symbols = consts
dotnet_naming_rule.consts.style = pascal
dotnet_naming_rule.consts.severity = warning
dotnet_naming_symbols.consts.applicable_kinds = field
dotnet_naming_symbols.consts.required_modifiers = const
# Private fields: _camelCase.
dotnet_naming_rule.private_fields.symbols = private_fields
dotnet_naming_rule.private_fields.style = underscore_camel
dotnet_naming_rule.private_fields.severity = warning
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.capitalization = camel_case
dotnet_naming_style.underscore_camel.required_prefix = _

dotnet_naming_style.pascal.capitalization = pascal_case
dotnet_diagnostic.IDE1006.severity = warning
