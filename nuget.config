<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- One source, regardless of machine-wide config: reproducible restores, and no NU1507 under central package management. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
